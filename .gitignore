# 构建工具链：整个 gradle 发行包 268MB，是本机自持的工具，不进仓库
tools/gradle-8.5/
tools/gradle-8.5-bin.zip

# Android 构建产物
phone/.gradle/
phone/build/
phone/app/build/
*.apk
*.aab

# 本机 SDK 绝对路径，换台机器就不对了
local.properties

# 服务运行时的日志和 pid（日志里印着本机局域网 IP）
run/
*.log
server.pid

# 测试用收流目录与编译出来的 class
test/inbox/
test/*.class

# 手工验证截图：拍的是这台电脑的真实文件列表
shots/

# 杂项
node_modules/
.DS_Store
Thumbs.db
desktop.ini

# 早先实验留下的本机标识，代码已不再读它
server/.serverid
